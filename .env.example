# OpenNotebookLM Environment Configuration
# Copy this file to .env and update with your values

# Application Settings
# The root Docker Compose file always runs APP_ENV=production and DEBUG=false.
# These defaults are for a backend started directly during development.
APP_NAME=OpenNotebookLM
APP_ENV=development
APP_PORT=8000
DEBUG=false

# Database
DB_PATH=./data/opennotebook.db
DATABASE_URL=sqlite:///./data/opennotebook.db
# One bounded worker is the safest SQLite default. Raise only after measuring
# model memory and write-lock contention; jobs are durable across restarts.
INGESTION_WORKER_CONCURRENCY=1

# Embedding Configuration
EMB_BACKEND=sqlitevec  # Options: sqlitevec, faiss
# Multilingual. Changing this invalidates every stored vector — see the
# README's Embeddings section for the re-index steps.
EMB_MODEL_NAME=intfloat/multilingual-e5-base
EMB_DIMENSION=768  # corrected from the model at startup

# LLM Configuration
# auto uses the first provider configured below, in the order
# Claude -> OpenAI -> local server. Name one to pin it.
LLM_MODE=auto  # Options: auto, claude, openai, local, none
LOCAL_MODEL_CONTEXT_SIZE=2048
LOCAL_MODEL_MAX_TOKENS=512

# Cloud API Keys (Optional — without one, answers are extractive, not generated)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Any provider speaking the OpenAI chat-completions API can serve this path —
# put its /v1 endpoint here and an OPENAI_MODEL that provider actually offers.
# Leave empty for OpenAI itself. Examples:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
# Groq only, for its reasoning models (qwen3.6-27b, MiniMax M2.7). Unset, they
# return the whole chain of thought inside the answer, in <think> tags.
#   hidden  drop it — the answer only
#   parsed  move it to a separate `reasoning` field
#   raw     the provider default: <think> tags inside the answer
# The reasoning is generated and billed either way, and counts against a
# request's max_tokens (512 from services/rag.py), so a non-reasoning model such
# as llama-3.3-70b-versatile remains the cheaper way to get a clean answer.
# Leave empty for OpenAI and every other provider — unknown parameters are
# rejected.
OPENAI_REASONING_FORMAT=
# A reasoning model writes its thinking into the output budget before the
# answer, so a small budget truncates the reply rather than the thinking. A
# request's max_tokens (512 from services/rag.py) is raised to at least this
# floor. Measured on qwen3.6-27b: a summary turn needed 1915 output tokens.
OPENAI_MIN_MAX_TOKENS=2048
# What a caller gets when it asks for as much as the model will give rather than
# naming a number — which is what Studio's mind map and video summary do, because
# a reply cut off mid-JSON parses to nothing. Leave empty to read the limit from
# the provider: OpenAI-compatible /v1/models reports max_completion_tokens, so a
# new model needs no change here. (Omitting max_tokens from the request is NOT
# the same thing: Groq then applies its own 2048 default and truncates.)
LLM_MAX_OUTPUT_TOKENS=
# Ceiling on one request's prompt PLUS its max_tokens. Providers count both
# against a rate limit and refuse the whole request before the model sees it:
# Groq's on-demand tier allows 8000 a minute, which qwen3.6-27b's own
# 16384-token output limit cannot fit under. Leave empty and the ceiling is
# learned from the first refusal that names one, at the cost of one refused
# request per feature that asks; set it to skip that.
LLM_MAX_REQUEST_TOKENS=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Reasoning depth: low, medium, high, xhigh, max. Answering from retrieved
# chunks is not reasoning-heavy, so low trades depth for latency.
CLAUDE_EFFORT=low
# Thinking is on by default and shares the output budget with the answer, so a
# request's max_tokens is raised to at least this floor.
CLAUDE_MIN_MAX_TOKENS=2048
# What a caller asking for the model's limit gets on the Claude path, which
# cannot discover it the way the OpenAI path does: the Messages API requires
# max_tokens, and while current models accept up to 128k, that needs streaming to
# stay inside the SDK's HTTP timeout — and nothing here streams.
CLAUDE_MAX_OUTPUT_TOKENS=16000

# Local OpenAI-compatible server (Ollama, llama.cpp, vLLM).
# The /v1 suffix is required — it is the OpenAI-compatible path.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2  # must match a model you have pulled

# YouTube Configuration
ENABLE_YT_TRANSCRIPTION=true
YT_API_KEY=

# File Upload Settings
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,txt,md

# Chunk Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_CHUNKS_PER_DOC=1000

# Retrieval Configuration
RETRIEVAL_TOP_K=5
# Candidates each retriever offers before fusion.
RETRIEVAL_CANDIDATE_K=30
# Minimum cosine similarity for a dense candidate. 0 disables the cut: measured
# e5 similarities sit between 0.67 and 0.71 whether or not a chunk is relevant.
RETRIEVAL_MIN_SCORE=0.0
# Dense + BM25 retrieval fused by reciprocal rank. Costs no extra memory.
HYBRID_ENABLED=true
HYBRID_RRF_K=60
# Jaccard token overlap at which two candidates count as the same passage.
DEDUPE_JACCARD=0.9
# Ceiling on the characters of retrieved context put into a prompt.
CONTEXT_CHAR_BUDGET=12000
# Legacy heuristic reranker, consulted only when HYBRID_ENABLED=false.
RERANK_ENABLED=true
RERANK_ALPHA=0.7
RERANK_BETA=0.2
RERANK_GAMMA=0.1

# Security
# Set this to the public frontend origins allowed to call the backend directly.
# Browser calls from the shipped frontend are same-origin and go through /api.
SECRET_KEY=change-this-secret-key-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_MAX_KEYS=10000
TRUST_PROXY_HEADERS=false
# Development defaults to open registration. To opt a production deployment in:
# ALLOW_PUBLIC_REGISTRATION=true

# Cache
# Blank means the bounded per-process memory cache for a backend run directly.
# Docker Compose supplies redis://redis:6379/0; its with-cache profile starts
# that internal-only service, and the backend falls back to memory when absent.
REDIS_URL=
# Compose caps the optional Redis process at this amount. Its allkeys-lru
# policy is safe because evicted scope markers are recreated with fresh opaque
# versions, so older TTL data can miss but can never become reachable again.
# Compose disables Redis AOF/RDB persistence and provides no Redis volume;
# restarting the optional service deliberately starts with an empty cache.
REDIS_MAXMEMORY=256mb
CACHE_NAMESPACE=opennotebooklm
# Per backend process: at most this many cached values, plus separately at most
# this many project/document scope-version markers.
CACHE_MAX_ENTRIES=10000

# URL imports
MAX_URL_DOWNLOAD_MB=10
MAX_URL_REDIRECTS=5
URL_CONNECT_TIMEOUT_SECONDS=5
URL_READ_TIMEOUT_SECONDS=30
URL_DOWNLOAD_TIMEOUT_SECONDS=30

# Authentication
# Signing key for access tokens. Docker Compose refuses to render when this is
# missing or empty, and any other non-development startup refuses it too.
# Development falls back to a key that lasts a single process, so sign-ins do
# not survive a restart. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Monitoring
ENABLE_METRICS=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Webhooks: no implementation exists. Settings rejects undeclared keys, so
# uncommenting one stops the backend until its field and implementation exist.
# WEBHOOK_ENABLED=false
# WEBHOOK_URL=
# WEBHOOK_SECRET=
