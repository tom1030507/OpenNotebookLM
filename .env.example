# OpenNotebookLM Environment Configuration
# Copy this file to .env and update with your values

# Application Settings
APP_NAME=OpenNotebookLM
APP_ENV=development
APP_PORT=8000
DEBUG=false

# Database
DB_PATH=./data/opennotebook.db
DATABASE_URL=sqlite:///./data/opennotebook.db

# Embedding Configuration
EMB_BACKEND=sqlitevec  # Options: sqlitevec, faiss
# Multilingual. Changing this invalidates every stored vector — see the
# README's Embeddings section for the re-index steps.
EMB_MODEL_NAME=BAAI/bge-m3
EMB_DIMENSION=1024  # corrected from the model at startup

# LLM Configuration
# auto uses the first provider configured below, in the order
# Claude -> OpenAI -> local server. Name one to pin it.
LLM_MODE=auto  # Options: auto, claude, openai, local, none
LOCAL_MODEL_CONTEXT_SIZE=2048
LOCAL_MODEL_MAX_TOKENS=512

# Cloud API Keys (Optional — without one, answers are extractive, not generated)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Any provider speaking the OpenAI chat-completions API can serve this path —
# put its /v1 endpoint here and an OPENAI_MODEL that provider actually offers.
# Leave empty for OpenAI itself. Examples:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
# Groq only, for its reasoning models (qwen3.6-27b, MiniMax M2.7). Unset, they
# return the whole chain of thought inside the answer, in <think> tags.
#   hidden  drop it — the answer only
#   parsed  move it to a separate `reasoning` field
#   raw     the provider default: <think> tags inside the answer
# The reasoning is generated and billed either way, and counts against a
# request's max_tokens (512 from services/rag.py), so a non-reasoning model such
# as llama-3.3-70b-versatile remains the cheaper way to get a clean answer.
# Leave empty for OpenAI and every other provider — unknown parameters are
# rejected.
OPENAI_REASONING_FORMAT=
# A reasoning model writes its thinking into the output budget before the
# answer, so a small budget truncates the reply rather than the thinking. A
# request's max_tokens (512 from services/rag.py) is raised to at least this
# floor. Measured on qwen3.6-27b: a summary turn needed 1915 output tokens.
OPENAI_MIN_MAX_TOKENS=2048
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Reasoning depth: low, medium, high, xhigh, max. Answering from retrieved
# chunks is not reasoning-heavy, so low trades depth for latency.
CLAUDE_EFFORT=low
# Thinking is on by default and shares the output budget with the answer, so a
# request's max_tokens is raised to at least this floor.
CLAUDE_MIN_MAX_TOKENS=2048

# Local OpenAI-compatible server (Ollama, llama.cpp, vLLM).
# The /v1 suffix is required — it is the OpenAI-compatible path.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2  # must match a model you have pulled

# YouTube Configuration
ENABLE_YT_TRANSCRIPTION=true
YT_API_KEY=

# File Upload Settings
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,txt,md

# Chunk Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_CHUNKS_PER_DOC=1000

# Retrieval Configuration
RETRIEVAL_TOP_K=5
RERANK_ENABLED=true
RERANK_ALPHA=0.7
RERANK_BETA=0.2
RERANK_GAMMA=0.1

# Security
SECRET_KEY=change-this-secret-key-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Authentication
# Signing key for access tokens. Required whenever APP_ENV is not
# "development"; development falls back to a key that lasts a single process,
# so sign-ins do not survive a restart. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Monitoring
ENABLE_METRICS=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Settings below are NOT read by the application yet. `Settings` rejects any key
# it does not declare, so uncommenting one stops the backend from starting —
# declare the field in backend/app/config.py first.
#
# Redis cache. `docker compose --profile with-cache` starts the server, but
# services/cache.py reaches it through a `hasattr(settings, 'redis_url')` guard
# that is always false, so the in-memory cache is what actually runs.
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600            # cache.py hardcodes its TTLs per entry type
#
# Webhooks: no implementation exists.
# WEBHOOK_ENABLED=false
# WEBHOOK_URL=
# WEBHOOK_SECRET=
