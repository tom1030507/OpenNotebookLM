{
  "description": "Retrieval-quality evaluation set. Ground truth is answer-bearing text, not chunk ids, so the same questions stay comparable across changes to the chunker. Every must_contain string was checked to appear only in the listed expect_docs, so a correct retrieval is never scored as a miss.",
  "corpus": [
    {
      "id": "en-rag",
      "lang": "en",
      "url": "https://en.wikipedia.org/wiki/Retrieval-augmented_generation"
    },
    {
      "id": "en-attention",
      "lang": "en",
      "url": "https://en.wikipedia.org/wiki/Attention_(machine_learning)"
    },
    {
      "id": "en-transformer",
      "lang": "en",
      "url": "https://en.wikipedia.org/wiki/Transformer_(deep_learning_architecture)"
    },
    {
      "id": "zh-rag",
      "lang": "zh",
      "url": "https://zh.wikipedia.org/zh-tw/%E6%AA%A2%E7%B4%A2%E5%A2%9E%E5%BC%B7%E7%94%9F%E6%88%90"
    },
    {
      "id": "zh-transformer",
      "lang": "zh",
      "url": "https://zh.wikipedia.org/zh-tw/Transformer%E6%A8%A1%E5%9E%8B"
    },
    {
      "id": "zh-attention",
      "lang": "zh",
      "url": "https://zh.wikipedia.org/zh-tw/%E6%B3%A8%E6%84%8F%E5%8A%9B%E6%A9%9F%E5%88%B6"
    }
  ],
  "queries": [
    {
      "id": "en-01",
      "lang": "en",
      "mode": "mono",
      "query": "How did Ars Technica describe what RAG does to an LLM?",
      "expect_docs": [
        "en-rag"
      ],
      "must_contain": [
        "blending the LLM process with a web search"
      ]
    },
    {
      "id": "en-02",
      "lang": "en",
      "mode": "mono",
      "query": "Which space telescope did Google's LLM demo get wrong, and what did the error cost?",
      "expect_docs": [
        "en-rag"
      ],
      "must_contain": [
        "James Webb Space Telescope"
      ]
    },
    {
      "id": "en-03",
      "lang": "en",
      "mode": "mono",
      "query": "What is prompt stuffing and why does it change the model's answer?",
      "expect_docs": [
        "en-rag",
        "zh-rag"
      ],
      "must_contain": [
        "prompt stuffing"
      ]
    },
    {
      "id": "en-04",
      "lang": "en",
      "mode": "mono",
      "query": "What is the Inverse Cloze Task used for when pre-training a retriever?",
      "expect_docs": [
        "en-rag"
      ],
      "must_contain": [
        "Inverse Cloze Task"
      ]
    },
    {
      "id": "en-05",
      "lang": "en",
      "mode": "mono",
      "query": "What does it mean that attention uses soft weights rather than fixed ones?",
      "expect_docs": [
        "en-attention"
      ],
      "must_contain": [
        "soft weights"
      ]
    },
    {
      "id": "en-06",
      "lang": "en",
      "mode": "mono",
      "query": "Which efficient attention variant is called Linformer?",
      "expect_docs": [
        "en-attention"
      ],
      "must_contain": [
        "Linformer"
      ]
    },
    {
      "id": "en-07",
      "lang": "en",
      "mode": "mono",
      "query": "What is a thought vector?",
      "expect_docs": [
        "en-attention",
        "zh-attention"
      ],
      "must_contain": [
        "thought vector"
      ]
    },
    {
      "id": "en-08",
      "lang": "en",
      "mode": "mono",
      "query": "How does the query-key mechanism compute attention weights?",
      "expect_docs": [
        "en-attention",
        "zh-attention"
      ],
      "must_contain": [
        "query-key"
      ]
    },
    {
      "id": "en-09",
      "lang": "en",
      "mode": "mono",
      "query": "What is positional encoding and why does a transformer need it?",
      "expect_docs": [
        "en-transformer"
      ],
      "must_contain": [
        "positional encoding"
      ]
    },
    {
      "id": "en-10",
      "lang": "en",
      "mode": "mono",
      "query": "What is ALiBi and how does it bias attention?",
      "expect_docs": [
        "en-transformer"
      ],
      "must_contain": [
        "ALiBi"
      ]
    },
    {
      "id": "en-11",
      "lang": "en",
      "mode": "mono",
      "query": "How does a KV cache speed up autoregressive decoding?",
      "expect_docs": [
        "en-transformer"
      ],
      "must_contain": [
        "KV cache"
      ]
    },
    {
      "id": "en-12",
      "lang": "en",
      "mode": "mono",
      "query": "What does RMSNorm replace and where is it used in a transformer?",
      "expect_docs": [
        "en-transformer"
      ],
      "must_contain": [
        "RMSNorm"
      ]
    },
    {
      "id": "zh-01",
      "lang": "zh",
      "mode": "mono",
