# Application
APP_NAME=OpenNotebookLM
APP_PORT=8000
APP_ENV=development
DEBUG=true

# Database
DB_PATH=./data/opennotebook.db
DATABASE_URL=sqlite:///./data/opennotebook.db

# Embedding Backend
EMB_BACKEND=sqlitevec  # Options: sqlitevec, faiss
# Multilingual. Changing this invalidates every stored vector — see the
# README's Embeddings section for the re-index steps.
EMB_MODEL_NAME=intfloat/multilingual-e5-base
EMB_DIMENSION=768  # corrected from the model at startup

# LLM Configuration
# auto uses the first provider configured below: Claude -> OpenAI -> local.
LLM_MODE=auto  # Options: auto, claude, openai, local, none
LOCAL_MODEL_CONTEXT_SIZE=2048
LOCAL_MODEL_MAX_TOKENS=512

# Cloud API Keys (optional — without one, answers are extractive, not generated)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Empty for OpenAI itself. Any chat-completions-compatible provider works —
# Groq (https://api.groq.com/openai/v1), OpenRouter, DeepSeek, Gemini's
# compatibility layer — paired with an OPENAI_MODEL that provider offers.
OPENAI_BASE_URL=
# Groq only: parsed, raw, or hidden. Keeps its reasoning models from returning
# their chain of thought inside the answer. Empty everywhere else.
OPENAI_REASONING_FORMAT=
# Floor for a request's output budget. Reasoning models spend it on thinking
# before answering, so too small a value truncates the answer.
OPENAI_MIN_MAX_TOKENS=2048
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low  # low, medium, high, xhigh, max
CLAUDE_MIN_MAX_TOKENS=2048

# Local OpenAI-compatible server. In Docker, point at the ollama service.
# The /v1 suffix is required.
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.2

# YouTube Configuration
ENABLE_YT_TRANSCRIPTION=true
YT_API_KEY=

# File Upload Limits
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,txt,md

# Security
SECRET_KEY=change-this-secret-key-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Monitoring
ENABLE_METRICS=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_MAX_KEYS=10000
TRUST_PROXY_HEADERS=false
# Closed by default in production. Bootstrap with python -m scripts.create_user.
ALLOW_PUBLIC_REGISTRATION=false

# URL imports
MAX_URL_DOWNLOAD_MB=10
MAX_URL_REDIRECTS=5
URL_CONNECT_TIMEOUT_SECONDS=5
URL_READ_TIMEOUT_SECONDS=30
URL_DOWNLOAD_TIMEOUT_SECONDS=30

# Chunk Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_CHUNKS_PER_DOC=1000

# Retrieval Configuration
RETRIEVAL_TOP_K=5
# Candidates each retriever offers before fusion.
RETRIEVAL_CANDIDATE_K=30
# Minimum cosine similarity for a dense candidate. 0 disables the cut: measured
# e5 similarities sit between 0.67 and 0.71 whether or not a chunk is relevant.
RETRIEVAL_MIN_SCORE=0.0
# Dense + BM25 retrieval fused by reciprocal rank. Costs no extra memory.
HYBRID_ENABLED=true
HYBRID_RRF_K=60
# Jaccard token overlap at which two candidates count as the same passage.
DEDUPE_JACCARD=0.9
# Ceiling on the characters of retrieved context put into a prompt.
CONTEXT_CHAR_BUDGET=12000
# Legacy heuristic reranker, consulted only when HYBRID_ENABLED=false.
RERANK_ENABLED=true
RERANK_ALPHA=0.7
RERANK_BETA=0.2
RERANK_GAMMA=0.1
